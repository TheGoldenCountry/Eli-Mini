{
  "name": "Eli-Mini",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends chromium ffmpeg && python -m pip install -U pip && python -m pip install -U -r requirements.txt",
  "postStartCommand": "python -m pip install -U -r requirements.txt",
  "remoteEnv": {
    "YOUTUBE_BROWSER_PATH": "/usr/bin/chromium"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
