{
  "name": "Eli-Mini",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "PATH": "/usr/local/python/current/bin:/usr/local/py-utils/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends chromium ffmpeg && python -m pip install -U pip && python -m pip install -U -r requirements.txt",
  "postStartCommand": "python -m pip install -U -r requirements.txt",
  "remoteEnv": {
    "YOUTUBE_BROWSER_PATH": "/usr/bin/chromium"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python"
      }
    }
  }
}
