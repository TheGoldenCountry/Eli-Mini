# Copy this file to .env and fill in your Discord bot token.
DISCORD_TOKEN=your-bot-token-here

# Optional: restrict slash-command sync to one server while developing.
# DISCORD_GUILD_ID=your-server-id

# Lavalink runs locally in the Codespace by default.
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=eliminimini

# Optional YouTube OAuth fallback.
# Use a separate/burner YouTube account, not your primary account.
# LAVALINK_YOUTUBE_OAUTH_ENABLED=true
# LAVALINK_YOUTUBE_REFRESH_TOKEN=<refresh-token-after-oauth-flow>
