# Copy this file to .env and add your Discord bot token.
DISCORD_TOKEN=your-bot-token-here

# YouTube authentication (pick ONE only when YouTube blocks yt-dlp).
# Same machine as your browser:
# YOUTUBE_BROWSER=chrome

# GitHub Codespaces/VPS/server:
# YOUTUBE_COOKIES_FILE=/absolute/path/to/cookies.txt

# Or store the cookies as a Codespaces secret:
# YOUTUBE_COOKIES_B64=<base64-encoded-cookies.txt>
