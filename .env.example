# Copy this file to .env and add your Discord bot token.
DISCORD_TOKEN=your-bot-token-here

# FFmpeg executable.
FFMPEG_PATH=ffmpeg

# GitHub Codespaces uses the Chromium installed by .devcontainer.
YOUTUBE_BROWSER_PATH=/usr/bin/chromium

# Optional: same-machine browser cookies.
# YOUTUBE_BROWSER=chrome

# Optional: route YouTube extraction through a proxy with an allowed public IP.
# If using YOUTUBE_COOKIES_B64, the browser session should use the same proxy/IP.
# Generic proxy (HTTP/HTTPS/SOCKS):
# YOUTUBE_PROXY=http://username:password@host:port
#
# Webshare dedicated YouTube Proxy:
# YOUTUBE_PROXY_ENDPOINT=proxy.example.com
# YOUTUBE_PROXY_PORT=30000
# YOUTUBE_PROXY_USERNAME=your-webshare-username
# YOUTUBE_PROXY_PASSWORD=your-webshare-password
# Keep this session ID stable when using the same YouTube cookies/session.
# YOUTUBE_PROXY_SESSION=eliminimini

# Recommended for Codespaces/server IP bot-checks:
# export a YouTube cookies.txt and base64-encode it, then store the result
# as a Codespaces secret/environment variable.
# YOUTUBE_COOKIES_B64=<base64-encoded-cookies.txt>
